{
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo",
    "target": "ES2023",
    // Tests exercise both halves of the app, so they see Node and DOM. Neither the
    // server nor the UI project gets the other's globals.
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "paths": { "@/*": ["./src/ui/*"], "@shared/*": ["./src/shared/*"] }
  },
  // Only the plain-TS modules tests import. Pulling in src/ui/**/*.ts would drag
  // in main.ts and its .vue imports, which belong to the UI project.
  "include": [
    "test/**/*.ts",
    "src/server/**/*.ts",
    "src/shared/**/*.ts",
    "src/ui/composables/**/*.ts",
    "src/ui/stores/**/*.ts",
    "src/ui/types/**/*.ts"
  ]
}
